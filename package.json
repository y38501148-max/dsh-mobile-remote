{
  "name": "@muzermat/dsh-mobile-remote",
  "version": "0.1.0",
  "type": "module",
  "description": "Mobile remote foundations for DeepSeek Harness (local-only development preview)",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:host": "node --test tests/host.integration.mjs",
    "prepare": "node build.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "src",
    "build.mjs",
    "LICENSE",
    "docs"
  ],
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.6"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y38501148-max/dsh-mobile-remote.git"
  }
}
